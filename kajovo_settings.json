{
  "db_path": "kajovo.sqlite",
  "log_dir": "D:\\kajovong\\LOG",
  "cache_dir": "D:\\kajovong\\cache",
  "retry": {
    "max_attempts": 6,
    "base_delay_s": 0.8,
    "max_delay_s": 20.0,
    "jitter_s": 0.25,
    "circuit_breaker_failures": 6,
    "circuit_breaker_cooldown_s": 20.0
  },
  "logging": {
    "max_total_mb": 2048,
    "max_runs": 200,
    "encrypt_logs": false,
    "mask_secrets": true
  },
  "pricing": {
    "source_url": "https://openai.com/api/pricing/",
    "cache_ttl_hours": 72,
    "auto_refresh_on_start": true
  },
  "security": {
    "allow_upload_sensitive": true,
    "deny_extensions_in": [
      ".exe",
      ".dll",
      ".zip",
      ".7z",
      ".rar",
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".pdf",
      ".db",
      ".sqlite",
      ".pkl",
      ".pt",
      ".onnx"
    ],
    "allow_extensions_in": null,
    "deny_globs_in": [
      "**/.git/**",
      "**/node_modules/**",
      "**/venv/**",
      "**/.venv/**",
      "**/LOG/**"
    ],
    "allow_globs_in": null
  },
  "smtp": {
    "host": "",
    "port": 587,
    "username": "",
    "password": "",
    "use_tls": true,
    "use_ssl": false,
    "from_email": "",
    "to_email": ""
  },
  "ssh": {
    "user": "",
    "host": "",
    "key": "",
    "password": "",
    "pin_required": false
  },
  "batch_poll_interval_s": 3.5,
  "batch_timeout_s": 3620.0,
  "response_timeout_s": 300.0,
  "default_model": "gpt-5.4",
  "default_temperature": 0.2,
  "dry_run_modify": false
}