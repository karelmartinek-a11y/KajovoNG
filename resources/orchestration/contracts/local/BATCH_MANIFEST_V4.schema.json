{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        4
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "route": {
      "type": "string",
      "enum": [
        "responses_batch",
        "image_batch"
      ]
    },
    "model": {
      "type": "string",
      "pattern": "\\S"
    },
    "endpoint": {
      "type": "string",
      "enum": [
        "/v1/responses",
        "/v1/images/edits",
        "/v1/images/generations"
      ]
    },
    "wave_no": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "custom_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "work_order_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "target_path": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "body_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_target_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "custom_id",
          "work_order_hash",
          "target_id",
          "target_path",
          "body_hash",
          "expected_target_hash"
        ],
        "additionalProperties": false
      }
    },
    "input_file_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_batch_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "prepared",
        "input_uploaded",
        "submitting",
        "submission_unknown",
        "submitted",
        "remote_terminal",
        "imported",
        "partial",
        "failed"
      ]
    }
  },
  "required": [
    "version",
    "run_id",
    "manifest_id",
    "route",
    "model",
    "endpoint",
    "wave_no",
    "rows",
    "input_file_id",
    "provider_batch_id",
    "state"
  ],
  "additionalProperties": false
}
